# הסיסמה היחידה לכניסה לכלי (חובה)
APP_PASSWORD=

# אופציונלי: מפתח נפרד לחתימת עוגיית ההתחברות. אם לא מוגדר, נעשה שימוש ב-APP_PASSWORD.
AUTH_SECRET=

# מחרוזת חיבור למסד הנתונים - נוצרת אוטומטית כשמחברים Postgres דרך
# Vercel: Storage → Create Database → Postgres (Neon), ומקושרת לפרויקט.
# לא צריך למלא ידנית - Vercel מזריקה את המשתנה הזה אוטומטית ב-Production/Preview/Development.
DATABASE_URL=
